<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_theme_blue"
    tools:context=".activity.StatusPreviewActivity">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="42dp"
        android:src="@drawable/ic_chevron"
        app:tint="@color/color_text_primary" />

    <ImageView
        android:id="@+id/img_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btn_back"
        android:layout_above="@id/btn_download"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <VideoView
        android:id="@+id/video_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btn_back"
        android:layout_above="@id/btn_download"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_download"
        style="@style/TextViewLocal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_purple_gradient_500"
        android:backgroundTint="@color/white"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="@string/download"
        android:textColor="@color/black"
        android:textSize="@dimen/ts_14" />

</RelativeLayout>
