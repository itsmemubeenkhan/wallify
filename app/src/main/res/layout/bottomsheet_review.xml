<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_thumb"
            app:tint="@color/color_text_primary" />

        <TextView
            style="@style/TextViewLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/enjoying_app"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>

    <TextView
        style="@style/TextViewLocal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/review_message"
        android:textColor="@color/color_text_primary_80"
        android:textSize="@dimen/ts_13" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_never"
            style="@style/TextViewLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/never"
            android:textColor="@color/color_text_primary_80"
            android:textSize="@dimen/ts_13" />

        <TextView
            android:id="@+id/btn_not_now"
            style="@style/TextViewLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/not_now"
            android:textColor="@color/color_text_primary_80"
            android:textSize="@dimen/ts_13" />

        <TextView
            android:id="@+id/btn_rate_now"
            style="@style/TextViewLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_purple_gradient_500"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/rate_now"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/ts_13" />
    </LinearLayout>

</LinearLayout>
